<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <!-- Serve actual static files that exist in /public/ directly -->
                <rule name="Serve Public Static Files" stopProcessing="true">
                    <match url="^(.+)$" ignoreCase="true" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{DOCUMENT_ROOT}\public\{R:1}" matchType="IsFile" />
                    </conditions>
                    <action type="Rewrite" url="public/{R:1}" />
                </rule>
                <!-- Route everything else to Laravel index.php -->
                <rule name="Laravel Application" stopProcessing="true">
                    <match url="^(.*)$" ignoreCase="false" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="public/index.php" appendQueryString="true" />
                </rule>
            </rules>
        </rewrite>
        <httpErrors errorMode="Detailed" />
        <staticContent>
            <mimeMap fileExtension=".woff" mimeType="application/x-font-woff" />
            <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
        </staticContent>
    </system.webServer>
</configuration>
